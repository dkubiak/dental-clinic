{
  "name": "dental-clinic-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "serve:dist": "http-server dist/dental-clinic-frontend/browser -p 4200 --proxy http://localhost:4200?",
    "e2e:theme": "playwright test e2e/us2-theme-toggle.spec.ts e2e/us5-theme-contrast.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:quiet": "../scripts/quiet.sh npm test",
    "lint:quiet": "../scripts/quiet.sh npm run lint",
    "e2e:quiet": "../scripts/quiet.sh npm run e2e"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.7.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.1.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "1.57.0",
    "@vitest/browser": "^4.0.8",
    "angular-eslint": "^19.0.0",
    "eslint": "^9.16.0",
    "http-server": "^14.1.1",
    "jsdom": "^25.0.0",
    "otpauth": "^9.3.4",
    "prettier": "^3.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.8"
  }
}
